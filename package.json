{
  "name": "mdreader",
  "version": "0.3.1",
  "description": "支持实时渲染、Mermaid 图表与主题切换的 Markdown 桌面工具",
  "main": "./out/main/index.js",
  "author": "Aides",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.tauri.config.mjs",
    "build:web": "vite build --config vite.tauri.config.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "lint": "eslint src scripts --no-warn-ignored",
    "sync-version": "node scripts/sync-version.mjs",
    "sync-ux": "node scripts/sync-ux.mjs",
    "check:commands": "node scripts/check-commands.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "dist": "electron-vite build && electron-builder --win",
    "postinstall": "node scripts/copy-vditor.mjs && node scripts/sync-version.mjs && electron-builder install-app-deps"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "vite-plugin-static-copy": "^4.1.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "echarts": "^6.1.0",
    "html-to-image": "^1.11.13",
    "lucide-vue-next": "^0.577.0",
    "mind-elixir": "^4.6.2",
    "sql-formatter": "^15.8.2",
    "vditor": "^4.0.0",
    "vue": "^3.5.43",
    "xlsx": "^0.18.5"
  }
}
