{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdReader",
  "version": "0.4.0",
  "identifier": "com.qiuyj.mdreader",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist-web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MdReader",
        "width": 1280,
        "height": 840,
        "minWidth": 760,
        "minHeight": 540,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: http: https:; media-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "resources": {
      "icons/md-file.ico": "md-file.ico"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown 文档",
        "description": "Markdown 文档",
        "role": "Editor"
      }
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsi"
      }
    }
  }
}
